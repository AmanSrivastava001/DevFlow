# EXAMPLE ONLY; do not commit your real .env
# Use SPRING_PROFILES_ACTIVE=prod when deploying.
# Create a PostgreSQL database in your hosting provider.
DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
# At least 32 random bytes, use a secrets manager
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYING
# Comma separated, only required when frontend and backend are deployed separately
CORS_ORIGINS=https://your-real-site.example
PORT=8080
